# ArchScale Nexus — Environment Variables
# Copy this file to .env and fill in the values

# ─── Database ───────────────────────────────────────────────────────
# For local development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./archscale.db
SYNC_DATABASE_URL=sqlite:///./archscale.db

# For production (Neon PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/archscale_nexus?sslmode=require
# SYNC_DATABASE_URL=postgresql://user:password@host.neon.tech/archscale_nexus?sslmode=require

# ─── Authentication (JWT) ──────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-64-character-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AI (Gemini) ──────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Environment ──────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://archscale-nexus.vercel.app"]

# ─── Optional Services ───────────────────────────────────────────
RESEND_API_KEY=
CLOUDINARY_URL=
